            </tr>
         </thead>
         <tbody>
            <tr>
               <td>
                        <select id="ddlUsers" class="form-control my-1 mr-sm-2">
                            <option></option>
                            <option value="0" @(ViewBag.PersonID != null && Convert.ToInt16(ViewBag.PersonID) == 0 ? "selected" : "")>NCI</option>

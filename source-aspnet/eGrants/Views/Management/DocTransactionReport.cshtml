                        <option id="last_month">Last Month</option>
                     }
                     @if (Convert.ToString(ViewBag.DateRange) == "this_week")
                     {
                        <option id="this_week" selected="selected">This Week</option>
                     }
                     else
                     {
                        <option id="this_week">This Week</option>
                     }
                     @if (Convert.ToString(ViewBag.DateRange) == "this_month")
                     {
                        <option id="this_month" selected="selected">This Month</option>
                     }
                     else
                     {
                        <option id="this_month">This Month</option>
                     }
                  </select>
               </td>
            </tr>
         <tr>
            <td colspan="3">                  
               <button AccessKey="R" ID="btnRoute" class="btn btn-primary my-1 mr-sm-2" title="Click to route [shift + alt + R]" OnClick="show_search();">
                  Range
               </button></td>
         </tr>
         <tr>

         </tr>
            <tr>
               @* <td colspan="1"> *@
               @*    <button AccessKey="R" ID="btnRoute" class="btn btn-primary my-1 mr-sm-2" title="Click to route [shift + alt + R]" OnClick="show_search();"> *@
               @*       Range *@
               @*    </button> *@
               @* </td> *@
               <td colspan="3">
                  <div id="ShowSearch" style="display: none" class="align-content-center">
                     <label for="txtStartDay" class="float-left align-middle my-1 mr-sm-2">From:</label>
                     <input type="text" class="form-control float-left  my-1" name="docdate" id="txtStartDay" style="width: 120px;" title="Insert document date"/>
                     <script type="text/javascript">

                        $('#txtStartDay').datepicker({
//                           showOn: "both",
                           buttonImageOnly: true,
                           //buttonImage: '../Content/images/calendar.png',
                           //buttonText: "Calendar"
                        });
                        </script>

                     @* <input type="text" id="txtStartDay" class="form-control" style="width: 100px;" value="@ViewBag.StartDate" />&#0160;(mm/dd/yyyy) *@
                     @* &#0160;&#0160;&#0160;&#0160; *@
                     <label for="txtEndDay" class="float-left my-1 mx-2">To:</label>
                     <input type="text" class="form-control float-left my-1" name="docdate" id="txtEndDay" style="width: 120px;" title="Insert document date"/>
                     <script type="text/javascript">
                        $('#txtEndDay').datepicker({
//                        showOn: "both",
                        buttonImageOnly: true,
                        @*buttonImage: '../Content/images/calendar.png',
                        buttonText: "Calendar"*@
                        });
                     </script>
                     @* <input type="text" id="txtEndDay" class="form-control" style="width: 100px;" value="@ViewBag.EndDate" />&#0160;(mm/dd/yyyy) *@
                     @* &#0160;&#0160; *@
                     <button type="button" accesskey="V" class="btn btn-primary float-left my-1 mx-2" id="btnCreatReport" title="Click  to Search [shift + alt + V]" onclick="return create_report()"><u>V</u>iew Report</button>
                  </div>
               </td>
            </tr>
         </tbody>
      </table>
   </div><!--end well-->
   @*</form>*@

<br />
    @if (ViewBag.EgrantsDocs != null && ViewBag.EgrantsDocs.Count >= 1)
    {
        var docs = (List<eGrants.Models.DocTransactionHistory>)ViewBag.EgrantsDocs;

        <style>
            .custom-docs-table td,
            .custom-docs-table th {
                padding: 4px 8px;
                line-height: 1.2;
            }

            .custom-docs-table thead th {
                border-top: none !important;
                border-bottom: none !important;
                background-color: #003366;
                color: #ffffff;
                font-weight: bold;
            }

            .custom-docs-table tbody tr:nth-child(odd) {
                background-color: #ffffff;
            }

            .custom-docs-table tbody tr:nth-child(even) {
                background-color: #cfcfcf;
            }
        </style>


        <table class="table custom-docs-table">
            <thead>
                <tr>
                    <th>Grant Number</th>
                    <th>Category Name</th>
                    <th>Transaction By</th>
                    <th>Transaction Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in docs)
                {
                    <tr>
                        <td><strong>@item.full_grant_num</strong></td>
                        <td>
                            <a href="javascript:show_doc('@item.url')">
                                <strong>@item.category_name</strong>
                            </a>
                        </td>
                        <td><strong>@item.person_name</strong></td>
                        <td><strong>@item.transaction_date</strong></td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pager -->
        <div class="pager">
            @{
                var actionName = "To_Report";
                int startPage = Math.Max(1, ViewBag.PageIndex - 5);
                int endPage = Math.Min(ViewBag.TotalPages, startPage + 9);

                // Build common route values
                var baseRouteValues = new RouteValueDictionary {
                { "transaction_type", ViewBag.TransactionType },
                { "person_id", ViewBag.PersonID }
                };

                if (ViewBag.UsingDateFilter == true)
                {
                    baseRouteValues["start_date"] = ViewBag.StartDate;
                    baseRouteValues["end_date"] = ViewBag.EndDate;
                }
                else
                {
                    baseRouteValues["date_range"] = ViewBag.DateRange;
                }
            }

            @if (ViewBag.PageIndex > 1 || ViewBag.TotalPages > 1)
            {
                var firstPage = new RouteValueDictionary(baseRouteValues) { ["pageIndex"] = 1 };
                var prevPage = new RouteValueDictionary(baseRouteValues) { ["pageIndex"] = ViewBag.PageIndex - 1 };

                <a href="@Url.Action(actionName, firstPage)">&lt;&lt;</a>
                <a href="@Url.Action(actionName, prevPage)">&lt;</a>
            }

            @if (ViewBag.TotalPages > 1)
            {
                @for (int i = startPage; i <= endPage; i++)
                {
                    if (i == ViewBag.PageIndex)
                    {
                        <span><strong>@i</strong></span>
                    }
                    else
                    {
                        var pageRoute = new RouteValueDictionary(baseRouteValues) { ["pageIndex"] = i };
                        <a href="@Url.Action(actionName, pageRoute)">@i</a>
                    }
                }
            }

            @if (ViewBag.PageIndex < ViewBag.TotalPages)
            {
                var nextPage = new RouteValueDictionary(baseRouteValues) { ["pageIndex"] = ViewBag.PageIndex + 1 };
                var lastPage = new RouteValueDictionary(baseRouteValues) { ["pageIndex"] = ViewBag.TotalPages };

                <a href="@Url.Action(actionName, nextPage)">&gt;</a>
                <a href="@Url.Action(actionName, lastPage)">&gt;&gt;</a>
            }
        </div>

    }
    else if (ViewBag.HasSearched == true)
    {
        <p>No documents found.</p>
    }


</div>
    
    <!--end main-->

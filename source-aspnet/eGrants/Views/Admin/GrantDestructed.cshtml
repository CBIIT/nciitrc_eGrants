@using Microsoft.AspNetCore.Html
@using eGrants.Models
@{
    ViewBag.Title = "eGrants [Access Control Module]";
    Layout = "~/Views/Shared/_egrants_header.cshtml";
}

<link rel="stylesheet" type="text/css" href="~/css/egrants.css" />

<script language="JavaScript">
    var currenturl = window.document.location.href;

    function to_search() {
        if (document.getElementById("txtKeyword").value == '') {
            alert("Please inser keyword to search");
            document.getElementById("txtKeyword").focus();
            return false;
        } else var keyword = document.getElementById("txtKeyword").value;

        var url="@Url.Action("Search_Grant_Destructed", "FlagMaintenance")?search_str=" + keyword;
        window.document.location.href = url;
    }

    function show_appl(appl_id) {
        var url = "@Url.Action("by_appl", "Egrants")?appl_id=" + appl_id;
        window.open(url, top);
    }
</script>

<form name="frmGetInfo">
    <input type="text" hidden id="hidIndexID" name="indexid" value="@ViewBag.IndexID" />
    <input type="text" hidden id="hidActiveID" name="activeid" value="@ViewBag.ActiveID" />
</form>

<div id="main">
    <!--start main-->
    <div>
        @Html.Partial("~/Views/Admin/_AdminMenuIndex.cshtml")
    </div>
    <div id="caption">
        <b id="page_title">Grant Excluded From Archival</b><br />
        @Html.ActionLink("Grants Flag Maintenance ", "Index", "FlagMaintenance", new { area = "Egrants_Admin" }, null)
    </div>
    <!--start to show -->
    <div id="modify" style="width:800px">
        <table width="800">
            <tr height="20">
                <td><b>For Information Only:</b></td>
                <td>Following Grants have been exproted from QVR Archival Exclusion system. The best way</td>
            </tr>
            <tr height="20">
                <td colspan="2">to create an Exclusion is in QVR so that Impac could also exclude them from annual purging.</td>
            </tr>
            <tr>
                <td width="180" valign="bottom"><b>Key Word Search:</b></td>
                <td width="600">
                    <input name="txtKeyword" id="txtKeyword" type="text" class="smallfont" size="18" title="Insert Key Word to search" value="@ViewBag.SearchStr" />
                    &#0160;
                    <button class="btn btn-primary btn-xs" AccessKey="S" OnClick="return to_search()" title"Click here to search [shift + alt + S]">
                        <u>S</u>earch
                    </button>
                    &#0160;
                    (search by serial number, creator or date mm/dd/yyyy)
                </td>
            </tr>
            <tr>
                <td></td>
                <td valign="bottom">@Html.ActionLink("Show All Records", "Show_Grant_Destructed", "FlagMaintenance", new { area = "Egrants_Admin" }, null)</td>
            </tr>
        </table>
    </div>
</div>
<div style="width:800px;">
    @{
        var appls = ViewBag.Appls as List<ApplFlags>;
        int currentPage = ViewBag.Page ?? 1;
        int totalPages = ViewBag.TotalPages ?? 1;
        string curSort = ViewBag.SortColumn as string ?? "";
        string curDir = ViewBag.SortDirection as string ?? "asc";
        int totalRecords = ViewBag.TotalRecords ?? 0;

        Func<string, string, IHtmlContent> sortLink = (display, column) =>
        {
            string nextDir = (curSort == column && curDir == "asc") ? "desc" : "asc";
            var linkUrl = Url.Action("Show_Grant_Destructed", new
            {
                page = currentPage,
                sortColumn = column,
                sortDirection = nextDir
            });
            return new HtmlString($"<a href=\"{linkUrl}\">{display}</a>");
        };
    }
    <!-- top pagination: 5 pages, <, > -->
    @if (totalPages > 1)
    {
        int startPage = 1, endPage = 5;
        if (currentPage - 2 < 2)
        {
            startPage = 1;
            endPage = Math.Min(5, totalPages);
        }
        else if (currentPage + 2 > totalPages)
        {
            startPage = totalPages - 4;
            if (startPage < 1) startPage = 1;
            endPage = totalPages;
        }
        else
        {
            startPage = currentPage - 2;
            endPage = currentPage + 2;
        }
        <div class="webgrid-pagination" style="margin-bottom:10px">
            @for (int i = startPage; i <= endPage; i++)
            {
                if (i == currentPage)
                {
                    <span class="current-page">@i</span>
                }
                else
                {
                    <a href="@Url.Action("Show_Grant_Destructed", new { page = i, sortColumn = curSort, sortDirection = curDir })">@i</a>
                }
            }
        </div>
    }

    <table class="webgrid-table">
        <thead class="webgrid-header">
            <tr>
                <th class="col-larg">@sortLink("Grant Number", "fgn")</th>
                <th class="col-exlarg">@sortLink("Exclusion Reason", "exclusion_reason")</th>
                <th class="col-larg">@sortLink("Creator", "creator")</th>
                <th class="col-med">@sortLink("Created", "created_date")</th>
                <th class="col-med">@sortLink("Applid", "appl_id")</th>
            </tr>
        </thead>
        <tbody>
            @{
                int rowIndex = 0;
            }
            @if (appls != null && appls.Any())
            {
                foreach (var item in appls)
                {
                    var rowClass = rowIndex % 2 == 0 ? "webgrid-odd-row-style" : "webgrid-even-row-style";
                    <tr class="@rowClass">
                        <td class="col-larg">
                            <a href="javascript:show_appl('@item.appl_id')">@item.fgn</a>
                        </td>
                        <td class="col-exlarg">@item.exclusion_reason</td>
                        <td class="col-larg">@item.creator</td>
                        <td class="col-med">@item.created_date</td>
                        <td class="col-med">@item.appl_id</td>
                    </tr>
                    ++rowIndex;
                }
                
            }
        </tbody>
    </table>

    <!-- bottom pagination: 10 pages, <, > -->
    @if (totalPages > 1)
    {
        int startPage = 1, endPage = 10;
        if (currentPage - 2 < 2)
        {
            startPage = 1;
            endPage = Math.Min(10, totalPages);
        }
        else if (currentPage + 4 >= totalPages)
        {
            startPage = totalPages - 9;
            if (startPage < 1) startPage = 1;
            endPage = totalPages;
        }
        else
        {
            startPage = currentPage - 5;
            if (startPage < 1) startPage = 1;
            endPage = currentPage + 4;
            if (endPage > totalPages) endPage = totalPages;
        }
        <div class="webgrid-pagination" style="margin-top:10px">
            @if (currentPage > 1)
            {
                <a href="@Url.Action("Show_Grant_Destructed", new { page = currentPage - 1, sortColumn = curSort, sortDirection = curDir })">&lt;</a>
            }
            @for (int i = startPage; i <= endPage; i++)
            {
                if (i == currentPage)
                {
                    <span class="current-page">@i</span>
                }
                else
                {
                    <a href="@Url.Action("Show_Grant_Destructed", new { page = i, sortColumn = curSort, sortDirection = curDir })">@i</a>
                }
            }
            @if (currentPage < totalPages)
            {
                <a href="@Url.Action("Show_Grant_Destructed", new { page = currentPage + 1, sortColumn = curSort, sortDirection = curDir })">&gt;</a>
            }
        </div>
    }
    <br />
</div>

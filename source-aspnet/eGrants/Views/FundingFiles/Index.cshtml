@{
    ViewBag.Title = "egrant Funding Files[NCI OGA]";
    Layout = "~/Views/Shared/_egrants_header.cshtml";
}

<script language="JavaScript">
    function view_edit() {
        var d = new Date();
        var y = d.getFullYear();
        var m = d.getMonth();
        if (m > 9) {
            y = y + 1;
        }
        var url = "@Url.Action("ViewEdit", "EgrantsFunding")?fy=" + y;
        window.self.location = url;
    }
</script>

<div id="main">
    <div id="caption"><b id="page_title">NCI Funding Files Index</b></div>
    <br />
    @if (Convert.ToInt32(Context.Session.GetInt32("position_id")) > 4)
    {
        <a href="JavaScript:view_edit()"><b>Funding Document Quality Control</b></a>
    }
    <br /><br />
    <div>
        <a href="@Url.Action("ViewAll", "EgrantsFunding", new { fy = 2014 })" target="_self">FY2014 NCI Master Funding File</a><br />

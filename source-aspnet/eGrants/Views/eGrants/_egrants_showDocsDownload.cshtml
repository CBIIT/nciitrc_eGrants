                $("#closeoutChildTable_@appl_id tr").each(function() {
  if ($(this).find("input[type='checkbox']").prop('checked') == true) {
         var found = data.downloadDataList.filter(function (item) { return item.url === closeoutUrl; });
        if (found != null) {
      if (found[0].error == null) {
           $(this).find('img').attr('src', '/images/new-fa-circle-check.gif');
    $(this).find('img').attr('title', 'File Download Successful!');
                  $(this).find('img').css('visibility', 'visible');
  countSuccess++;
   } else {
    $(this).find('img').attr('src', '/images/new-fa-circle-exclamation.gif');
      $(this).find('img').attr('title', 'File Not Found.');
   $(this).find('img').css('visibility', 'visible');

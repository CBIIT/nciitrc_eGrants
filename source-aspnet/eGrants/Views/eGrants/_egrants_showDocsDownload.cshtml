        <script language="javascript" type="text/javascript">
      // ====================================================================================
            // DOCUMENT DOWNLOAD GRID - DataTables Implementation
  // ====================================================================================
        // 
      // This script initializes the DataTables grid for document selection and download.
          // Key functionality:
 // - Load documents via AJAX from /Egrants/LoadDocsGrid
       // - Checkbox selection for individual and bulk download
       // - Expand/collapse child rows for Financial Reports and Closeout Notifications
            // - Download selected files as a ZIP archive
            //
            // PERFORMANCE NOTE:
     // The download itself is now processed in parallel on the server side
// (see DocumentService.ProcessDocumentDownloadAsync). The timeout is set to
        // 10 minutes (600000ms) to accommodate large batch downloads, though actual
       // processing time should be significantly faster due to parallel processing.
          // ====================================================================================

         $("#overlay").show();

            $(document).ready(function () {
         // Firefox warning for SVG icon compatibility
       var userAgent = navigator.userAgent;
 if (userAgent.indexOf("Firefox") > -1) {
          document.getElementById("afd_ff_warning").style.display = 'inline';
        }

       // Initialize moment.js date formatting for DataTables
              $.fn.dataTable.moment('MM/DD/YYYY');
 
      // Custom date sorting for non-standard date formats
            jQuery.extend(jQuery.fn.dataTableExt.oSort,
            {
               'dateNonStandard-asc': function(a, b) {
                var x = Date.parse(a);
     var y = Date.parse(b);
              if (x == y) { return 0; }
      if (isNaN(x) || x < y) { return 1; }
             if (isNaN(y) || x > y) { return -1; }
         },
       'dateNonStandard-desc': function(a, b) {
       var x = Date.parse(a);
         var y = Date.parse(b);
         if (x == y) { return 0; }
      if (isNaN(y) || x < y) { return -1; }
  if (isNaN(x) || x > y) { return 1; }
    }
               });

          // Initialize DataTable
        var table = $("#loadgridDownload_" + @appl_id).DataTable({
 paging: false,
     searching: false,
  ordering: true,
                order: [[2, 'asc']],
        processing: true,
        serverSide: false,
            filter: true,
           orderMulti: false,
      bInfo: false,
     timeout: 600000, // 10 minute timeout for large downloads
        initComplete: function(settings, json) {
      $("#overlay").hide();
  var info = this.api().page.info();
          },

     // Load document data via AJAX
        ajax: {
        url: "/Egrants/LoadDocsGrid?applId=" + @appl_id + "&searchType=" + $("#hidSearchType").val() + "&categoryList=" + $("#hidSelectedCats").val(),
  type: "GET",
            contentType: 'application/json; charset=utf=8',
     dataType: 'JSON',
         timeout: 600000,
         },
           stripeClasses: ['odd-row', 'even-row'],
         columnDefs: [
            { targets: [0, 3], orderable: false },
        { visible: true, searching: false, paging: false },
   { type: 'dateNonStandard', targets: [2] }
     ],
             columns: [
    {
        // Checkbox column for download selection
      className: "details-control",
         autoWidth: true,
         render: function(data, type, full, meta) {
    return renderDetailsControl(data, type, full, meta)
    }
    },
       {
              // Document name with link
    autoWidth: true,
       render: function(data, type, full, meta) {
          if (full.frc_destroyed == 0) {
         if (full.fsr_count > 1 && (full.document_name == "FFR" || full.document_name == "Financial Report")) {
         if (full.document_name == "Financial Report") {
  return "<a href=JavaScript:show_doc('" + full.url + "') title='show document'>" + full.document_name + "</a>";
         }
       if (full.document_name == "FFR") {
    return "<a href='#' title='Select Item To View'>" + full.document_name + "</a>";
    }
       } else if (full.attachment_count > 0) {
     return "<a href=JavaScript:show_doc('" + full.url + "') title='show document'>" + full.document_name + "</a>";
    } else if (full.document_name == "Closeout Notification") {
      return "<a href='#' title='Select Item To View'>" + full.document_name + "</a>";
 } else {
          return "<a href=JavaScript:show_doc(\"" + full.url + "\") title=\"show document\">" + full.document_name + "</a>";
 }
     } else {
    return "<strike>" + full.document_name + "</strike>";
     }
           }
      },
   {
        // Document date column
      className: 'document_date',
             data: "doc_date",
      autoWidth: true,
       render: function(data, type, full, meta) {
        if (full.document_date == "" || full.document_date == null) {
          return '';
   } else {
     return moment(data).format('MM/DD/YYYY');
 }
                 }
         },
        {
          // Status icon column
  // MIGRATION NOTE: Using GIF images instead of Font Awesome SVGs
   // because SVG replacement doesn't work reliably in .NET 8 Razor views
      className: 'icon_display',
         authWidth: true,
     render: function(data, type, full, meta) {
               // i2e files show warning icon (not supported for download)
           var str = ((full.url && full.url.substring(0, 11) == "https://i2e" 
  ? "<img src=\"/images/new-fa-file-excel.gif\" title=\"File URL is not supported.\" />" 
               : "<img style=\"visibility: hidden\" src=\"/images/new-fa-file-lines.gif\" title=\"File URL is supported.\"/>"));

 return str;
       }
      }
        ]
   });

var mode = document.getElementById("hidMode").value;

  // ====================================================================================
        // CHECKBOX EVENT HANDLERS
                // ====================================================================================

        // Header checkbox - select/deselect all
         $('#loadgridDownload_' + @appl_id + ' thead').on('click', 'input.showDownloadAll', function() {
         var isAllChecked = $(this).prop('checked');
      $.each($('#loadgridDownload_' + @appl_id + ' input.showDownload'), function() {
          if (!$(this).prop('disabled')) {
               if (isAllChecked) {
            // Expand child rows for composite documents
if ($(this).hasClass('FinancialReport') || $(this).hasClass('FFR')) {
         var tr = $(this).parents('tr');
       var row = table.row(tr);
     if (!row.child.isShown()) {
          getFinancialReport(row, @appl_id);
        }
    }
        if ($(this).hasClass('CloseoutNotifications')) {
           var tr = $(this).closest('tr');
             var row = table.row(tr);
  if (!row.child.isShown()) {
         getCloseoutNotification(row, @appl_id);
     }
         }
        if ($(this).hasClass('Attachments')) {
    var tr = $(this).closest('tr');
           var row = table.row(tr);
   if (!row.child.isShown()) {
              getAttchaments(row);
        }
        }
              $(this).prop('checked', true);
       } else {
    if ($(this).hasClass('FinancialReport') || $(this).hasClass('CloseoutNotifications') || $(this).hasClass('FFR')) {
       var tr = $(this).closest('tr');
    var row = table.row(tr);
       if (!row.child.isShown()) {
            row.child.hide();
              }
               }
   $(this).prop('checked', false);
              }
           }
        });
          });

           // Row checkbox click handler
     $('#loadgridDownload_' + @appl_id + ' tbody').on('click', 'input.showDownload', function() {
                 var isAllChecked = true;
     $.each($('#loadgridDownload_' + @appl_id + ' input.showDownload'), function() {
        if ($(this).hasClass('FinancialReport') || $(this).hasClass('FFR')) {
           var tr = $(this).closest('tr');
      var row = table.row(tr);
           if ($(this).prop('checked')) {
       getFinancialReport(row, @appl_id);
  }
     }
if ($(this).hasClass('CloseoutNotifications')) {
    var tr = $(this).closest('tr');
   var row = table.row(tr);
        if ($(this).prop('checked')) {
                     getCloseoutNotification(row, @appl_id);
  }
   }
   if ($(this).hasClass('Attachments')) {
           var tr = $(this).closest('tr');
        var row = table.row(tr);
            if ($(this).prop('checked')) {
  getAttachments(row);
      }
      }
    if (!$(this).prop('disabled') && !$(this).prop('checked')) {
  isAllChecked = false;
   }
          });
        // Update header checkbox state
              $('#checkboxall_' + @appl_id).prop('checked', isAllChecked);
     });

                // Child table checkbox handlers (Financial Reports, Closeout Notifications)
     // ... [existing handlers remain unchanged] ...

  // ====================================================================================
            // DOWNLOAD BUTTON CLICK HANDLER
   // ====================================================================================
    // 
         // MIGRATION CHANGES:
      // ------------------
    // 1. Changed from JSON content type to form-urlencoded
         //    - ASP.NET Core [FromForm] binding expects form data
   //    - $.param(dataToSend, true) serializes arrays correctly
          // 
         // 2. Data sent in POST body instead of URL query string
        //    - Avoids URL length limitations for large batches
      //    - More reliable for complex data structures
     // 
// 3. Server-side processing is now parallelized
                //    - DocumentService.ProcessDocumentDownloadAsync downloads in batches of 10
                //    - Expected ~3-5x performance improvement for multi-file downloads
   // ====================================================================================
      $('#downloadData_@appl_id').on('click', function() {
       var fsrUrl;
          var closeoutUrl;
        
        // Create download request object
       var dataToSend = {};
    dataToSend.appl = @appl_id;
   dataToSend.fullGrantNumber = "@fullGrantNumber";
  var list = new Array();

    // Collect all checked items for download
             $.each($('#loadgridDownload_' + @appl_id + ' input.showDownload'), function() {
    var tr = $(this).closest('tr');
          var row = table.row(tr);

     // Handle Financial Report and FFR child rows
    if ($(this).hasClass('FinancialReport') || $(this).hasClass('FFR')) {
   if (row.child.isShown()) {
 if ($(this).hasClass('FinancialReport')) {
 $("#ffrChildTable_@appl_id tr").each(function() {
                 if ($(this).find("input[type='checkbox']").prop('checked') == true) {
        fsrUrl = $(this).find("a[href^='JavaScript']").attr('name');
              var tag = $(this).find("a[href^='JavaScript']").attr('id');
            var categoryName = $(this).find("input[type='checkbox']").attr('value');
var documentDate;
 if (tag == 2) {
  documentDate = $(this).find("span[name='accepted_date']").text();
   } else if (tag == 3) {
     documentDate = $(this).find("span[name='created_date']").text();
     } else {
documentDate = null;
 }
     if (!fsrUrl) {
        tr.find('img').attr('src', '/images/new-fa-circle-exclamation.gif');
       tr.find('img').attr('title', 'File Not Found');
    tr.find('img').css('visibility', 'visible');
              } else {
   list.push(fsrUrl + "|" + categoryName + "|" + "" + "|" + "" + "|" + categoryName + "|" + documentDate + "|" + tag);
           $(this).find('img').attr('src', '/images/new-fa-spin.gif');
     $(this).find('img').attr('title', 'Downloading ...');
   $(this).find('img').css('visibility', 'visible');
  }
        }
    });
            }
   }
   } 
 // Handle Closeout Notification child rows
       else if ($(this).hasClass('CloseoutNotifications')) {
    if (row.child.isShown()) {
           $("#closeoutChildTable_@appl_id tr").each(function() {
             if ($(this).find("input[type='checkbox']").prop('checked') == true) {
              closeoutUrl = $(this).find("a[href^='JavaScript']").attr('name');
  var categoryName = $(this).find("input[type='checkbox']").attr('value');
var documentDate = $(this).find("span[name='created_date']").text();
        if (!closeoutUrl) {
             tr.find('img').attr('src', '/images/new-fa-circle-exclamation.gif');
      tr.find('img').attr('title', 'File Not Found');
       tr.find('img').css('visibility', 'visible');
     } else {
     list.push(closeoutUrl + "|" + "CloseoutNotification" + "|" + "" + "|" + "" + "|" + categoryName + "|" + documentDate + "|" + "");
   $(this).find('img').attr('src', '/images/new-fa-spin.gif');
             $(this).find('img').attr('title', 'Downloading ...');
        $(this).find('img').css('visibility', 'visible');
 }
   }
             });
           }
       } 
        // Handle standard document rows
    else {
 var data = row.data();
       if ($(this).prop('checked')) {
             if (!$(this).hasClass('FinancialReport') && !$(this).hasClass('CloseoutNotifications') && !$(this).hasClass('FFR')) {
           if (!data.url) {
       tr.find('img').attr('src', '/images/new-fa-circle-exclamation.gif');
       tr.find('img').attr('title', 'File Not Found');
                   tr.find('img').css('visibility', 'visible');
 } else {

       function switch_upload_mode(act) {
          if (act == "by_ddrop") {
             document.getElementById("by_ddrop").style.display = "inline";
             document.getElementById("by_file").style.display = "none";
             document.getElementById("by_email").style.display = "none";
             document.getElementById("btnDragdrop").style.display = "inline";
             Init();
          }

          if (act == "by_file") {
             document.getElementById("by_file").style.display = "inline";
             document.getElementById("by_ddrop").style.display = "none";
             document.getElementById("by_email").style.display = "none";
             document.getElementById("btnFileUpload").style.display = "inline";
          }

          if (act == "by_email") {
             document.getElementById("by_email").style.display = "inline";
             document.getElementById("by_ddrop").style.display = "none";
             document.getElementById("by_file").style.display = "none";
             document.getElementById("btnEmail").style.display = "inline";
          }
       }

       function clear_message(type) {
          //clear all message
           $("#mssg").css('display', 'none');
           $("#mssgGood").css('display', 'none');
          $('#notice').css('visibility', 'hidden');
       }

        // Replace the old upload_by_ddrop function
    async function upload_by_ddrop() {

        if (!check_file_dnd()) {
            return false;
        }

        // Generate unique upload ID
        const uploadId = generateUploadId();

        // Start SignalR tracking
        await window.fileUploadProgressManager.startUpload(uploadId, dropedfile.name);

        // Create FormData
        var frmdata = new FormData();
        frmdata.append('file', dropedfile);
        frmdata.append('uploadId', uploadId);
        frmdata.append('doc_id', document_id);
        frmdata.append('uploadType', 'replace');

        // Call the new SignalR-enabled endpoint
        try {
            const response = await fetch('/EgrantsDoc/UploadWithProgress', {
                method: 'POST',
                body: frmdata
            });

            const result = await response.json();

            if (result.success) {
                console.log('Upload queued successfully:', result.uploadId);
            } else {
                alert('Upload failed: ' + result.message);
            }
        } catch (error) {
            console.error('Upload error:', error);
            alert('Upload failed: ' + error.message);
        }

        clear_all("by_dd");
    }

    // Replace the old upload_pdf_by_ddrop function
    async function upload_pdf_by_ddrop() {
        if (!check_file_pdf_dnd()) {
            return false;
        }

        // For multiple files, upload each one separately with its own progress tracking
        for (let i = 0; i < dropedfiles.length; i++) {
            const uploadId = generateUploadId();
            const file = dropedfiles[i];

            await window.fileUploadProgressManager.startUpload(uploadId, file.name);

            var frmdata = new FormData();
            frmdata.append('file', file);
            frmdata.append('uploadId', uploadId);
            frmdata.append('doc_id', document_id);
            frmdata.append('uploadType', 'replace');
            frmdata.append('convertToPdf', 'true');

            try {
                const response = await fetch('/EgrantsDoc/UploadWithProgress', {
                    method: 'POST',
                    body: frmdata
                });

                const result = await response.json();

                if (!result.success) {
                    alert(`Upload failed for ${file.name}: ` + result.message);
                }
            } catch (error) {
                console.error(`Upload error for ${file.name}:`, error);
                alert(`Upload failed for ${file.name}: ` + error.message);
            }
        }

        clear_all("by_dd");
    }

    // Replace the old upload_by_file function
    async function upload_by_file() {
        if (check_file() == false) {
             return false;
        }

        const file = document.getElementById('customFile').files[0];
        const uploadId = generateUploadId();

        await window.fileUploadProgressManager.startUpload(uploadId, file.name);

        var frmdata = new FormData();
        frmdata.append('file', file);
        frmdata.append('uploadId', uploadId);
        frmdata.append('doc_id', document_id);
        frmdata.append('uploadType', 'replace');

        try {
            const response = await fetch('/EgrantsDoc/UploadWithProgress', {
                method: 'POST',
                body: frmdata
            });

            const result = await response.json();

            if (result.success) {
                console.log('Upload queued successfully:', result.uploadId);
            } else {
                alert('Upload failed: ' + result.message);
            }
        } catch (error) {
            console.error('Upload error:', error);
            alert('Upload failed: ' + error.message);
        }

        clear_all("by_file");
    }

    // Helper function to generate unique upload IDs
    function generateUploadId() {
        return 'upload_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
    }

    // Test if SignalR client is loaded
    console.log("SignalR available:", typeof signalR !== 'undefined');
    console.log("File upload manager:", window.fileUploadProgressManager);

    // Manually test the notification
    if (window.fileUploadProgressManager) {
        window.fileUploadProgressManager.showNotification(
            'Test',
            'This is a test notification',
            'success'
        );
    }

    console.log(typeof upload_by_ddrop);
    // Should output: "function"

    // Enable the button
    document.getElementById('btnDragdrop').disabled = false;

    // Now try clicking it, or call it manually
    // But first, you need a file in dropedfile variable
</script>

<div id="main" style="margin: 0; padding: 0;">
    <div id="caption">
        <b id="page_title">Replace Document</b>
    </div>
    <form name="frmGetInfo">
        <input type="text" hidden id="hidApplID" name="appl_id" value="@Model.ApplId" />
        <input type="text" hidden id="hidDocID" name="document_id" value="@Model.DocId" />
        <input type="text" hidden id="hidDocDate" name="document_date" value="@Model.DocDate" />
        <input type="text" hidden id="hidBrowserType" name="browser_type" value="@Context.Session.GetString("browser")" />
        <input type="text" hidden id="hidEgrantsEmail" name="egrants_email" value="@Context.Session.GetString("EgrantsDocEmail")">
    </form>

    <!--start upload document-->
    <div id="content" style="margin: 0; padding: 0;">
        <table>
            <tr>
                <td width="800">
                    <table width="800">
                        <thead>
                            <tr>
                                <td colspan="2" height="20"></td>
                            </tr>
                            <tr>
                                <td colspan="2" height="20"><b>Grant:</b>&#0160;&#0160;&#0160;&#0160;&#0160;&#0160;&#0160;&#0160;@Model.FullGrantNum </td>
                            </tr>
                            <tr>
                                <td colspan="2" height="20"><b>Category:</b>&#0160;&#0160;@Model.DocName </td>
                            </tr>
                            <tr>
                                <td colspan="2" height="20"><b>Date:</b>&#0160;&#0160;&#0160;&#0160;&#0160;&#0160;&#0160;&#0160;&#0160;@Model.DocDate </td>
                            </tr>
                            <tr>
                                <td colspan="2" height="20"></td>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </td>
            </tr>
        </table>
        <table width="1024">
            <tbody>
                <tr>
                    <!--show loading icon-->
                    <td width="80"><div class="loading" style="display:none"><img src="~/images/Loading.gif" width="50" /></div></td>
                    <td width="700" valign="top">

                        <div class="tab" style="width: 498px">
                            <button class="tablinks active" onclick="Docreate(event, 'btnDragdrop');Javascript:switch_upload_mode('by_ddrop')" id="li_ddrop"> Drag & Drop </button>

                            <button class="tablinks" onclick="Docreate(event, 'btnFileUpload');Javascript:switch_upload_mode('by_file')">Locate File and Upload</button>

                            <button class="tablinks" onclick="Docreate(event, 'btnEmail');Javascript:switch_upload_mode('by_email')">Upload <I>via</I> Email</></button>
                        </div>
                        <div id="myTabContent" style="width: 700px;">
                            <!--start upload by drag drop -->
                            <div class="tabcontent" id="by_ddrop" style="display: none">
                                <br />
                                <div id="dropArea">Drag-drop only one file here to upload</div><br />
                                <div style="display:inline">
                                    <button type="button" name="ReplaceByDdrop" id="btnDragdrop" class="btn btn-primary eGrantsDocBtn"
                                            disabled="disabled"
                                            onclick="return upload_by_ddrop();" accesskey="U" title="Click here to upload document [shift + alt + U]">
                                        <u>U</u>pload Document
                                    </button>
                                    <button type="button" name="ReplaceByDdrop" id="btnPdfDragdrop" class="btn btn-primary eGrantsDocBtn space-big-left" disabled="disabled" onclick="return upload_pdf_by_ddrop();" accesskey="U" title="Click here to convert a document to PDF and upload it [shift + alt + C]"><u>C</u>onvert to PDF & Upload</button> &#0160;&#0160;
                                </div>
                                <br style="clear:both" />
                                <div class="space-down">By clicking Upload or Convert to PDF & Upload, I confirm that no sensitive PII or PHI is included in this file.</div>
                            </div>
                            <!--end upload by drag drop-->
                            <!--start upload by file-->
                            <div class="tabcontent" id="by_file" style="display: none">
                                <form>
                                    <div class="custom-file my-2">
                                        <input type="file" class="custom-file-input" id="customFile" onchange="active_btnFileUpload()" multiple>
                                        <label class="custom-file-label" for="customFile">Choose files...</label>
                                    </div>
                                </form>
                                @* <input type="file" name="file" id="UploadFile" style="width="550px" height="40px;" onchange="active_btnFileUpload()" /><br /> *@
                                <div style="display: inline"><button type="button" style="display: inline" name="ReplaceByFile" id="btnFileUpload" class="btn btn-primary eGrantsDocBtn" onclick="return upload_by_file();" disabled="disabled" accesskey="U" title="Click here to upload document [shift + alt + U]"><u>U</u>pload Document</button>&#0160;</div>
                                <div style="display: inline"><button type="button" style="display: inline" name="ReplaceByPdfFile" id="btnFilePdfUpload" class="btn btn-primary eGrantsDocBtn" onclick="return upload_pdf_by_file();" disabled="disabled" accesskey="U" title="Click here to upload document [shift + alt + U]"><u>C</u>onvert to PDF & Upload</button>&#0160;</div>&#0160;&#0160;
                                <br style="clear:both" />
                                <div class="space-down">By clicking Upload or Convert to PDF & Upload, I confirm that no sensitive PII or PHI is included in this file.</div>
                            </div>
                            <!--end upload by file-->
                            <!--start upload by email-->
                            <div class="tabcontent" id="by_email" style="display:none">
                                <br /><br />
                                1. Click the button "Upload Via Email" to open an email window.<br /><br />
                                2. Attach document (<b>DO NOT</b> change the subject) and click send.<br /><br />
                                <div style="display: inline"><button type="button" style="display:inline" name="CreatByEmail" id="btnEmail" onclick="return upload_by_email()" class="btn btn-primary eGrantsDocBtn" AccessKey="U" title="Click here to upload document by email [shift + alt + U]"><u>U</u>pload via Email</button></div>
                                <div class="space-down">By clicking Upload or Convert to PDF & Upload, I confirm that no sensitive PII or PHI is included in this file.</div>
                            </div>
                            <!--end upload by email-->
                            <br /><br />
                            <!--show progress bar-->
                            <div class="progress" style="display:none">
                                <div id="progressBar" class="progress-bar" role="progressbar" style="width:0%; height:18px; text-align: center; line-height:18px; margin:0; padding:0;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <!--end progress bar-->
                        </div><!--end myTabContent-->
                        <button accesskey="R" class="btn btn-primary eGrantsReturnBtn" title="Click here to return previous page [alt + shift + R]" onclick="Javascript: back()"><u>R</u>eturn to eGrants File</button>&#0160;&#0160;
                        <a target="_new" href="#" id="notice" style="visibility: hidden"><img src="~/images/check_doc_btn.png" style="height: 35px;" title="Check Document" /></a>
                        <b id="done"><span id="mssgGood"></span></b>
                        <br style="clear:both" />
                        <div style="line-height: 30px; margin: 10px;">
                            <b id="done"><span id="mssg"></span></b>
                        </div>
                    </td>
                    <td style="width: 400px; padding-left: 50px;">
                        <div class="text-justify p-4" style="box-shadow: 0 3px 10px lightgray; width: 350px; height: 240px; line-height: normal; font-style: normal;">
                            <p><strong>Reminder:</strong> Sensitive Personally Identifiable Information (PII; e.g. Social Security Number, personal financial information, Alien Registration Number, etc.) or Protected Health Information (e.g. personal medical conditions, etc.) requires strict handling due to the increased risk to an individual if the data is compromised. Documents containing sensitive PII or PHI must not be uploaded into eGrants. More information can be found in the <a target="_new" href="https://policymanual.nih.gov/manage/chapter/view/1745">Manual Chapter 1745 - NIH Information Technology (IT) Privacy Program</a>.</p>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div><!--end content-->
</div><!--end main-->
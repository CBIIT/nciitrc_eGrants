                        @{
                            var displayMpiFlag = true;
                            if (grant.MPIContacts == null || grant.MPIContacts.Count == 0)
                            {
                                displayMpiFlag = false;
                            }
                            else if (Model.ApplID != null)
                            {
                                // this is appl specific, so hide MPI flag if this appl is not MPI
                                displayMpiFlag = false;
                                if (Model.appllayer_All != null || Model.appllayer_All.Count() == 0)
                                {
                                    var thisPagesApplID = (int)Model.ApplID;
                                    var appls = Model.appllayer_All as List<ApplLayerObject>;
                                    var theAppl = appls.Where(a => a.appl_id.ToString() == thisPagesApplID.ToString()).ToList();
                                    if (theAppl != null && theAppl.Count > 0 && theAppl[0] != null && theAppl[0].MPIContacts != null && theAppl[0].MPIContacts.Count() > 1)
                                    {
                                        displayMpiFlag = true;
                                    }
                                }
                            }
                            else if (Model.SelectedAppls != null)
                            {
                                // it's in ViewBag.SelectedAppls
                                displayMpiFlag = false;

                                var appls_from_vb = (string)Model.SelectedAppls;
                                var appls = Model.appllayer_All as List<ApplLayerObject>;
                                var appl_ids = appls_from_vb.Split(',');
                                var theAppls = appls;
                                if (!appls_from_vb.ToLower().Contains("all") && appl_ids.Count() < 2)
                                {
                                    // if there's only ONE then selectively display the MPI based on if that ONE appl has MPI
                                    theAppls = appls.Where(a => appl_ids.Contains(a.appl_id.ToString())).ToList();
                                }

                                if (theAppls.Any(ap => ap.MPIContacts != null && ap.MPIContacts.Count() > 1))
                                {
                                    displayMpiFlag = true;
                                }
                            }
                            else
                            {
                                // grant search and grant MPI info is populated
                                displayMpiFlag = false;
                                var appls = Model.appllayer_All as List<ApplLayerObject>;
                                var theAppls = appls.Where(a => a.grant_id == grant.grant_id).ToList();
                                if (theAppls.Any(apps => apps.MPIContacts != null && apps.MPIContacts.Count() > 1))
                                {
                                    displayMpiFlag = true;
                                }
                            }

                        }

                        @if (displayMpiFlag)
                        {
                            string grantLinkId = "grantLink" + grant.grant_id;
                            string imgLinkId = "imgLink" + grant.grant_id;
                            <span class="pl-2">
                                <a id="@grantLinkId" href="JavaScript:show_grant_with_flag('MPI', @Convert.ToInt32(grant.grant_id))">

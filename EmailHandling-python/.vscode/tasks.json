{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Create venv",
      "type": "shell",
      "command": "python -m venv .venv"
    },
    {
      "label": "Install dev deps",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python -m pip install --upgrade pip pytest ruff mypy"
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python -m pytest -q"
    },
    {
      "label": "Run lint",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python -m ruff check ."
    }
  ]
}

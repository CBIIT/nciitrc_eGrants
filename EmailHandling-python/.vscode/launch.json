{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Slice001 CLI",
      "type": "python",
      "request": "launch",
      "module": "app.main",
      "args": [
        "--subject",
        "Prior Approval: Carryover needed for Award 5P30CA082103-23",
        "--body",
        "Please review prior approval request.",
        "--debug",
        "n"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run tests (pytest)",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-q"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}

# SQL Server database connection (raw ODBC format — no URL encoding needed)
DATABASE_ODBC=DRIVER={ODBC Driver 18 for SQL Server};SERVER=hostname\instance,port;DATABASE=EIM;UID=egrantsuser;PWD=changeme;TrustServerCertificate=yes;Connection Timeout=45;

# Application settings
ENVIRONMENT=dev
APP_VERSION=2.0.0
APP_BUILD=
CORS_ORIGINS=["http://localhost:3000"]

# File server paths
IMAGE_SERVER_URL=https://egrants-dev.nci.nih.gov/docs/egrants
WEB_GRANT_URL=/local/content/web/egrants/wwwroot/docs/egrants

# Email settings
SMTP_HOST=mailfwd.nih.gov
SMTP_FROM=egrants-noreply@mail.nih.gov
SEND_MAIL=false
MAIL_OVERRIDE_ADDRESS=

# SiteMinder blacklist (comma-separated service accounts to ignore)
SM_USER_BLACKLIST=nciservermon,ncicbiitappscan,ncicbiitsecure
